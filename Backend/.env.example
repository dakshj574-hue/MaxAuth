# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=generate_with_node_crypto_randomBytes_32
JWT_REFRESH_SECRET=generate_with_node_crypto_randomBytes_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Magic Link ───────────────────────────────────────────────────────────────
MAGIC_LINK_SECRET=generate_with_node_crypto_randomBytes_32
MAGIC_LINK_EXPIRY=15m

# ─── MFA ──────────────────────────────────────────────────────────────────────
MFA_SECRET=generate_with_node_crypto_randomBytes_32

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=YourAppName

# ─── Generate secrets using ───────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
